# Copy to .env (gitignored) and edit. Everything here is optional — defaults shown.

# Host path on the Docker host that holds the models; bind-mounted into the container at
# /models. Point this at your ZFS dataset, NFS mount, or local directory. Default: /mnt/models
MODELS_HOST_PATH=/mnt/models

# Hugging Face token — only needed for gated/private repos. Get one at
# https://huggingface.co/settings/tokens  (leave blank for public-only access)
HF_TOKEN=

# Max concurrent downloads. Extra submissions wait in the queue (never rejected).
MAX_DOWNLOAD_WORKERS=3

# Seconds between periodic queue-state saves to data/download_queue.json.
QUEUE_SAVE_INTERVAL=30

# Seconds before a completed download row auto-clears from the UI.
COMPLETED_AUTO_CLEAR_SECONDS=10
